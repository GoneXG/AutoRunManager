#include <windows.h>

// Application manifest (requireAdministrator + common controls v6)
1 24 "app.manifest"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Shi"
            VALUE "FileDescription", "AutoStart Manager"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "AutoRunManager"
            VALUE "OriginalFilename", "AutoRunManager.exe"
            VALUE "ProductName", "AutoStart Manager"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
